{
  "apiVersion": "v1",
  "kind": "List",
  "items": [
    {
      "apiVersion": "v1",
      "kind": "ServiceAccount",
      "metadata": {
        "name": "knarr"
      },
      "automountServiceAccountToken": false
    },
    {
      "apiVersion": "rbac.authorization.k8s.io/v1",
      "kind": "Role",
      "metadata": {
        "name": "knarr"
      },
      "rules": []
    },
    {
      "apiVersion": "apps/v1",
      "kind": "Deployment",
      "metadata": {
        "name": "knarr"
      },
      "spec": {
        "replicas": 1,
        "strategy": {
          "type": "Recreate"
        },
        "selector": {
          "matchLabels": {
            "app.kubernetes.io/name": "knarr"
          }
        },
        "template": {
          "metadata": {
            "labels": {
              "app.kubernetes.io/name": "knarr"
            }
          },
          "spec": {
            "serviceAccountName": "knarr",
            "automountServiceAccountToken": false,
            "securityContext": {
              "runAsNonRoot": true,
              "runAsUser": 10001,
              "runAsGroup": 10001,
              "seccompProfile": {
                "type": "RuntimeDefault"
              }
            },
            "containers": [
              {
                "name": "knarr",
                "image": "knarr:local",
                "imagePullPolicy": "Never",
                "ports": [
                  {
                    "name": "http",
                    "containerPort": 8080
                  }
                ],
                "securityContext": {
                  "readOnlyRootFilesystem": true,
                  "allowPrivilegeEscalation": false,
                  "capabilities": {
                    "drop": [
                      "ALL"
                    ]
                  }
                },
                "resources": {
                  "requests": {
                    "cpu": "50m",
                    "memory": "256Mi"
                  },
                  "limits": {
                    "memory": "512Mi"
                  }
                },
                "volumeMounts": [
                  {
                    "name": "tmp",
                    "mountPath": "/tmp"
                  }
                ],
                "livenessProbe": {
                  "httpGet": {
                    "path": "/healthz",
                    "port": "http"
                  },
                  "periodSeconds": 5,
                  "timeoutSeconds": 2
                },
                "readinessProbe": {
                  "httpGet": {
                    "path": "/readyz",
                    "port": "http"
                  },
                  "periodSeconds": 5,
                  "timeoutSeconds": 2
                }
              }
            ],
            "volumes": [
              {
                "name": "tmp",
                "emptyDir": {}
              }
            ]
          }
        }
      }
    }
  ]
}
